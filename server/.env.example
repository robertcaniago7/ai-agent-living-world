# AI Agent Living World — server .env.example
# Salin ke server/.env (JANGAN commit .env — berisi API key).

# Port backend (frontend default mengarah ke http://localhost:8787)
PORT=8787

# --- Database ---
# Kosongkan = SQLite lokal (server/data/app.db). Isi untuk Postgres/Supabase:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Supabase Auth (opsional) ---
# Bila diisi, server memverifikasi JWT Supabase di setiap request.
# Bila kosong, server jalan mode DEMO single-user lokal.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# --- Provider LLM (isi MINIMAL 1 untuk live mode) ---
# OpenAI (atau provider OpenAI-compatible lain via OPENAI_BASE_URL):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini (free tier tersedia di https://aistudio.google.com):
# GEMINI_API_KEY=...
# Anthropic Claude:
# ANTHROPIC_API_KEY=sk-ant-...
