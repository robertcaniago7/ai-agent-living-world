# AI Agent Living World — environment variables
# Salin ke .env (jangan commit .env). Fase 1 (DEMO) tidak butuh apa pun di sini.
# Semua nilai di bawah hanya dipakai mulai Fase 3 (live mode).

# --- Supabase (Fase 3) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role key HANYA di server/worker, JANGAN pernah pakai prefix VITE_:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Backend worker (Fase 3) ---
WORKER_PORT=3001
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Provider LLM (Fase 3; disimpan di vault, bukan di file ini di produksi) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Mode ---
VITE_APP_MODE=demo
